OPENAI_API_KEY=
ENV=production
FRONTEND_URL=https://your-app.vercel.app
DB_PATH=/data/gymgpt.db

# Resend SMTP relay (smtp.resend.com:587, user=resend, pass=API key)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_xxxx
SMTP_FROM=LyftLogic <noreply@yourdomain.com>

# Optional tuning
SESSION_EXPIRY_DAYS=7
OTP_EXPIRY_MINUTES=15
ALLOW_INSECURE_LOGIN=0
